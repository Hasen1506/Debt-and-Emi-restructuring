# node_modules without a slash also matches a symlinked install.
node_modules
*.tsbuildinfo
.hypothesis/
.coverage
coverage/
htmlcov/
# Playwright / test output anywhere in the tree (not only web/)
test-results/
playwright-report/
blob-report/

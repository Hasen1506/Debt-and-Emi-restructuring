# Postgres connection string from Neon (or any Postgres host).
# Use the "pooled" connection string for serverless workloads.
# Example: postgresql+asyncpg://user:pass@host/db?ssl=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# Resend API key — used to send OTP codes via email.
# Get it from https://resend.com/api-keys (starts with re_).
RESEND_API_KEY=re_REPLACE_ME

# From-address for OTP emails. During dev you can use the Resend sandbox:
# onboarding@resend.dev (no domain verification required, only sends to
# the email you signed up with).
# In prod, use an address on a domain you've verified in Resend.
RESEND_FROM=onboarding@resend.dev

# (APP_SECRET used to be listed here; no code reads it. Session tokens are
# random and stored hashed, so there is no signing secret to set.)

# Comma-separated allowed origins for CORS (frontend URLs).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Notifications (G7) — all off by default; see DEPLOY.md "Notifications"
PAYDAY_EMAIL_ENABLED=false
DEADLINE_REMINDERS_ENABLED=false
PAYDAY_REPLY_INBOUND=false
NOTIFY_SIGNING_KEY=
NOTIFY_CRON_SECRET=
PUBLIC_APP_URL=http://localhost:3000
NOTIFY_REPLY_TO=
RESEND_WEBHOOK_SECRET=
